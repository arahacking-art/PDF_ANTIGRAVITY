FROM node:22-alpine

WORKDIR /app

# Se ejecuta como el usuario "node" (UID 1000) y no como root: ./frontend se monta
# como volumen y lo que el contenedor escribe ahí (p. ej. public/pdfjs, generado por
# scripts/copy-pdfjs-assets.mjs) quedaría a nombre de root en el equipo, rompiendo
# `pnpm build` local. UID 1000 coincide con el usuario habitual de un Linux de escritorio.
RUN corepack enable pnpm && chown node:node /app
USER node

# Mismo gestor y lockfile que producción (frontend/Dockerfile) para builds reproducibles
COPY --chown=node:node package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

CMD ["pnpm", "run", "dev", "--host"]
